# Bu dosyayı .env.local olarak kopyala ve gerçek değerleri doldur.
# .env.local git'e girmez (bkz. .gitignore); bu dosya sadece hangi anahtarların
# gerektiğini gösteren bir şablondur.

# --- Ücretsiz tarama (free-scan) — src/lib/free-scan/ ---
# Web-bağlantılı (grounded) birincil sağlayıcı — zorunlu, yoksa /api/free-scan
# 503 "yapılandırılmamış" hatası döner (bkz. src/lib/free-scan/provider.ts):
PERPLEXITY_API_KEY=

# Opsiyonel: extract.ts için daha isabetli JSON çıkarımı (yoksa isim-eşleştirmeli
# heuristik fallback kullanılır):
OPENAI_API_KEY=
# extract.ts'nin kullandığı ucuz model (varsayılan: gpt-5.4-nano):
FREE_SCAN_EXTRACT_MODEL=

# Opsiyonel: provider.ts'yi değiştirmek için (şu an sadece "perplexity" var):
FREE_SCAN_PROVIDER=

# Opsiyonel: Upstash Redis (yoksa bellek-içi rate limit + cache fallback kullanılır;
# tek instance'lık dev/preview için sorun değil, çoklu instance prod'da önerilir):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- İletişim formu (/contact) — src/app/api/contact/route.ts ---
# Resend (https://resend.com) API anahtarı — yoksa form 503 "yapılandırılmamış"
# hatası gösterir (aynı graceful-degrade deseni free-scan ile aynı):
RESEND_API_KEY=
# Form mesajlarının gideceği adres:
CONTACT_TO_EMAIL=
# Opsiyonel: gönderen adres (Resend'de doğrulanmış bir domainin varsa). Boşsa
# Resend'in doğrulama gerektirmeyen sandbox göndereni kullanılır:
RESEND_FROM_EMAIL=
# Opsiyonel: /contact sayfasında görünen doğrudan mailto: bağlantısı (istemci
# tarafında görünür — gizli bir şey koyma). Boşsa mailto linki gösterilmez:
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Sonraki fazlar (henüz kodda kullanılmıyor — bkz. README "Sonraki adımlar"
# ve docs/specs/F3-F5) — buraya sadece referans için bırakıldı, ilgili spec
# uygulanana kadar tanımlamana gerek yok: ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# SERPAPI_KEY=
